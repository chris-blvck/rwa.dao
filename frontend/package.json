{
  "name": "rwa-dao-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Portail createur RWA-DAO Palier 1 (frontend Next.js, mock-only) — consomme l'API mock du backend Python.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "opennextjs-cloudflare build",
    "cf:check": "npm run test && npm run typecheck && npm run cf:build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "test:css": "node tests/css-compatibility.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "^2.54.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "tailwindcss": {
      "postcss-selector-parser": "7.1.7",
      "postcss-nested": {
        "postcss-selector-parser": "7.1.7"
      }
    }
  }
}
