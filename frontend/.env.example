# ── RWA-DAO Creator Portal — Tier 1 (frontend) ─────────────────────────────────
# Mock-only: no secret key is required to run the demo.
# Copy this file to `.env.local` for local dev (NEVER commit `.env*`).

# Portal operating mode:
#   canned → embedded fixture responses, 100% offline, no backend (default, ideal demo/preview)
#   live   → the frontend proxies to the Python mock backend (FastAPI) below
RWA_MODE=canned

# Python mock backend URL (used only when RWA_MODE=live).
# Start the backend:  python -m app.main rwa-palier1-http-mock --serve --host 127.0.0.1 --port 8011
RWA_MOCK_API_BASE_URL=http://127.0.0.1:8011

# Dev/admin only: expose the footer mode switch and allow the `rwa-mode` cookie.
# Keep both empty in public previews/prod.
NEXT_PUBLIC_RWA_DEV_TOOLS=
RWA_ALLOW_MODE_COOKIE=

# (Optional, prod security) Shared secret to guard side-effecting routes.
# Leave empty for the demo. When set, guarded routes require the x-rwa-api-key header.
# API_GUARD_SECRET=

# ── Supabase (shared with the Exhelia production project) ──────────────────────
# RWA-DAO data is isolated under the `rwa_*` table namespace (migration in
# supabase/migrations/0001_rwa_creations.sql). The publishable/anon key is PUBLIC by
# design — rows are protected by RLS (owner-scoped). Set these in Netlify env / .env.local.
# Cloud "My videos" sync activates once wallet/auth is wired; until then the app uses
# localStorage and these can stay empty.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (used for Open Graph / absolute metadata). Optional.
NEXT_PUBLIC_SITE_URL=

# ── Video generation provider (wired but inert by default) ─────────────────────
# The studio's "Generate" calls /api/rwa/generate. It NEVER runs a real job until a provider
# is selected AND RWA_ALLOW_LIVE_GENERATION=1. Leave as mock for the demo (nothing generates).
RWA_VIDEO_PROVIDER=mock            # mock | qwen | higgsfield
RWA_ALLOW_LIVE_GENERATION=         # set to 1 to allow live runs (still requires a key)

# ── Alibaba-native path — Qwen Cloud / DashScope (REQUIRED for the Qwen hackathon) ──
# Set RWA_VIDEO_PROVIDER=qwen to generate on Alibaba's own DashScope API (Wanx still →
# Wan/HappyHorse video) AND RWA_LLM_PROVIDER=qwen to write captions on Qwen (qwen-max).
# One key unlocks both LLM + video. This is the qualifying path — NOT Higgsfield.
DASHSCOPE_API_KEY=                 # a.k.a. the Qwen Cloud / Model Studio key (or QWEN_API_KEY)
# RWA_LLM_PROVIDER=qwen            # captions via Qwen (else auto-selects by key presence)
# QWEN_MODEL=qwen-max              # LLM model override
# Video model — Wan is the default; HappyHorse 1.0 is Alibaba's flagship (native 1080p + audio),
# also on DashScope. To generate on HappyHorse, force it with ONE line:
# QWEN_VIDEO_MODEL=happyhorse-1.0-i2v   # forces this model for every video (i2v = image-to-video)
# Or override the per-family defaults:
# QWEN_WAN_I2V=wan2.2-i2v-flash
# QWEN_HAPPYHORSE_I2V=happyhorse-1.0-i2v
# DASHSCOPE_BASE_URL=             # override the region host if needed (default: intl)
# Verify the whole path in one call after deploy:
#   curl -H "Authorization: Bearer $CRON_SECRET" "$URL/api/rwa/agent/preflight?probe=1"

# ── Aggregator path — Higgsfield (works for the product, does NOT qualify for the hackathon) ──
# HIGGSFIELD_API_KEY=              # server-side only; RWA_VIDEO_PROVIDER=higgsfield to use it

# ── Guardrail reminders (the frontend stays mock-only) ──────────────────────────
# No real wallet signature, no live provider call, no token transfer, no publication,
# no automatic reward. Going "live" depends on the human prerequisites
# (see GET /api/mock/human-prerequisites on the backend).
